# ============================================================
# Enterprise Document Intelligence Platform — Environment Config
# ============================================================
# Copy this file to .env and fill in all values before starting.
# NEVER commit .env to version control.

# ─── Application ─────────────────────────────────────────────
APP_ENV=development                    # development | staging | production
APP_NAME="Enterprise Document Intelligence Platform"
APP_VERSION=1.0.0
SECRET_KEY=change-this-to-a-very-long-random-secret-key-256-bits
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── API Gateway ─────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
API_V1_PREFIX=/api/v1

# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=edip
POSTGRES_USER=edip_user
POSTGRES_PASSWORD=change-this-strong-password
DATABASE_URL=postgresql+asyncpg://edip_user:change-this-strong-password@postgres:5432/edip
DATABASE_URL_SYNC=postgresql://edip_user:change-this-strong-password@postgres:5432/edip

# ─── Redis ────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-this-redis-password
REDIS_URL=redis://:change-this-redis-password@redis:6379/0
REDIS_CACHE_TTL=3600

# ─── RabbitMQ ─────────────────────────────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=edip_user
RABBITMQ_PASSWORD=change-this-rabbit-password
RABBITMQ_VHOST=edip
CELERY_BROKER_URL=amqp://edip_user:change-this-rabbit-password@rabbitmq:5672/edip
CELERY_RESULT_BACKEND=redis://:change-this-redis-password@redis:6379/1

# ─── MinIO (S3-compatible Object Storage) ─────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-this-minio-secret
MINIO_BUCKET_DOCUMENTS=edip-documents
MINIO_BUCKET_PROCESSED=edip-processed
MINIO_USE_SSL=false
# For AWS S3 (production):
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1
# S3_BUCKET_DOCUMENTS=edip-documents-prod

# ─── OCR Service ──────────────────────────────────────────────
OCR_SERVICE_URL=http://ocr-service:8001
OCR_ENGINE=paddleocr                   # paddleocr | tesseract | ensemble
OCR_LANG=en                            # en | ch | fr | de | es | multi
OCR_CONFIDENCE_THRESHOLD=0.7
OCR_MAX_PAGES=500
TESSERACT_CMD=/usr/bin/tesseract

# ─── Embedding Service ────────────────────────────────────────
EMBEDDING_SERVICE_URL=http://embedding-service:8002
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5  # Primary embedding model
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=64
EMBEDDING_CACHE_TTL=86400

# Chunking settings
CHUNK_SIZE=512
CHUNK_OVERLAP=64
CHUNKING_STRATEGY=semantic             # semantic | recursive | clause | fixed

# ─── Vector Databases ─────────────────────────────────────────
VECTOR_DB=chroma                       # faiss | chroma | qdrant
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION_DOCUMENTS=edip_documents
FAISS_INDEX_PATH=/data/faiss_indexes
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=edip_documents

# ─── Retrieval Service ────────────────────────────────────────
RETRIEVAL_SERVICE_URL=http://retrieval-service:8003
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
RETRIEVAL_STRATEGY=hybrid              # dense | sparse | hybrid
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
BM25_K1=1.5
BM25_B=0.75

# ─── LLM Service ──────────────────────────────────────────────
LLM_SERVICE_URL=http://llm-service:8004
LLM_PRIMARY_PROVIDER=openai            # openai | anthropic | gemini | ollama
LLM_FALLBACK_PROVIDER=ollama
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1                    # Low temp for factual document Q&A
CONFIDENCE_THRESHOLD=0.7
MAX_CONTEXT_LENGTH=128000

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini
GOOGLE_API_KEY=your-google-api-key
GEMINI_MODEL=gemini-1.5-pro

# Ollama (local / on-premise)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b

# ─── Analytics Service ────────────────────────────────────────
ANALYTICS_SERVICE_URL=http://analytics-service:8005

# ─── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_APP_NAME="DocIntel Enterprise"

# ─── Monitoring ───────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=change-this-grafana-password
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=edip-api

# ─── Elasticsearch (for full-text search & ELK) ───────────────
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX_DOCUMENTS=edip_documents
ELASTICSEARCH_INDEX_AUDIT=edip_audit

# ─── Security ─────────────────────────────────────────────────
ENCRYPTION_KEY=change-this-32-byte-aes-encryption-key!
PII_MASKING_ENABLED=true
PROMPT_INJECTION_PROTECTION=true
MAX_UPLOAD_SIZE_MB=100
ALLOWED_FILE_TYPES=pdf,docx,txt,csv,xlsx,png,jpg,jpeg,tiff,eml,zip
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=100

# ─── Email / Notifications ────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@domain.com
SMTP_PASSWORD=your-app-password
NOTIFICATION_FROM_EMAIL=noreply@yourdomain.com

# ─── Multi-tenancy ────────────────────────────────────────────
DEFAULT_TENANT_ID=default
TENANT_ISOLATION=true

# ─── GDPR / Compliance ────────────────────────────────────────
DATA_RETENTION_DAYS=2555              # 7 years
AUDIT_LOG_RETENTION_DAYS=3650        # 10 years
GDPR_MODE=true
HIPAA_MODE=false
SOC2_MODE=true
