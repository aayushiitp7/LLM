# =============================================================
# Backend Environment — set ALL of these in Vercel dashboard
# =============================================================

# JWT
JWT_SECRET_KEY=generate-with-openssl-rand-hex-32
ALGORITHM=HS256

# OpenAI — enables real RAG chat (get at platform.openai.com)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Frontend URL (for CORS)
FRONTEND_URL=https://edip-frontend.vercel.app

# Optional: Neon Postgres (neon.tech, free tier)
DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.neon.tech/edip

# Optional: Upstash Redis (upstash.com, free tier)
UPSTASH_REDIS_URL=https://xxx.upstash.io
UPSTASH_REDIS_TOKEN=...

# Optional: Pinecone vector store (pinecone.io, free tier)
PINECONE_API_KEY=...
PINECONE_INDEX=edip-docs
